GR  = "#2ecc71"
PV  = "#9b59b6"
LP  = "#d7bde2"
DP  = "#6c3483"
BK  = "#e74c3c"

TPS = 20

CFG = {
    "cpu_alta":        75,
    "cpu_tope":        80,
    "temp_alta":       75,
    "temp_critica":    85,
    "bateria_baja":    20,
    "bateria_critica": 10,
    "nube_cada":       14,
    "nube_dura":        5,
    "dormir_tras":     40,
    "cpu_dormir":       8,
}

_PALETA = {
    "gato": "W_", "claro": "LG", "sombra": "MG",
    "borde": "DG", "hocico": "OR", "nariz": "PI",
}

def load_config():
    """Lee ~/.config/neko.toml si existe: [ajustes] y [colores]."""
    if tomllib is None:
        return
    path = os.path.expanduser("~/.config/neko.toml")
    try:
        with open(path, "rb") as fh:
            data = tomllib.load(fh)
    except FileNotFoundError:
        return
    except Exception as e:
        print(f"neko: config ignorada ({e})", file=sys.stderr)
        return
    for k, v in data.get("ajustes", {}).items():
        if k in CFG and isinstance(v, (int, float)):
            CFG[k] = v
    g = globals()
    for k, v in data.get("colores", {}).items():
        var = _PALETA.get(k)
        if var and isinstance(v, str):
            g[var] = v


def c(ch):
    return {
        ' ': None, 'W': W_, 'L': LG, 'M': MG, 'D': DG,
        'P': PI,   'B': BL, 'A': AQ, 'U': PU, 'R': RD,
        'O': OR,   'Y': YE, 'G': GR, 'V': PV, 'C': LP,
        'K': DP,   'E': BK,
    }.get(ch, None)

def c_bed(ch):
    return {' ': None, 'X': DG, 'C': LP, 'V': PV, 'K': DP}.get(ch, None)

BED = [
    " XXXXXXXXXXXX   ",
    " XCCCCCCCCVVX   ",
    " XCCCCCCCCVVX   ",
    " XKKKKKKKKKKX   ",
    " XKKKKKKKKKKX   ",
    " XXXXXXXXXXXX   ",
    " XX        XX   ",
]

def draw_bed(painter, ox, oy):
    for row, line in enumerate(BED):
        for col, ch in enumerate(line):
            color = c_bed(ch)
            if color is None:
                continue
            painter.fillRect(ox + col * PX, oy + row * PX, PX, PX, QColor(color))

